# --- OMC / temp (explicitly ignored per project setup) ---
.omc/
tmp/

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build output ---
dist/
build/
*.tsbuildinfo
.vite/

# --- Uploaded images (filesystem storage, auto-created on boot) ---
# Ignore the runtime-uploaded images but keep the (empty) folder via .gitkeep.
backend/uploads/*
!backend/uploads/.gitkeep

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Database (SQLite PoC) ---
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/prisma/dev.db*

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# --- Local AWS deployment artifacts ---
ops/aws/
aidit-deploy-key.pem
aidit-deploy-key-raw.pem
aidit-deploy-key-v2.pem

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Test / coverage ---
coverage/
.nyc_output/
playwright-report/
test-results/

# --- Demo recording (large, not committed) ---
/demo-aidit.mp4

# README media: frame sequence is regenerable, only the built GIF is committed
docs/assets/condense/
