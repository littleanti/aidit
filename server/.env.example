DATABASE_URL="file:./dev.db"
PORT=3001

# JWT secret used to sign and verify Bearer tokens.
# REQUIRED in production — generate with: openssl rand -hex 32
# If unset the server falls back to an insecure dev default and prints a warning.
# JWT_SECRET=change-me-in-production

# JWT token lifetime (default 7d). Accepts any value supported by the `ms` library
# (e.g. "7d", "24h", "3600").
# JWT_EXPIRES=7d

# Network bind address for the API server.
# Default: 0.0.0.0 (all interfaces). Set HOST=127.0.0.1 to keep the API
# reachable only from the local machine (e.g. behind a frontend dev proxy)
# and NOT exposed on the LAN.
# HOST=127.0.0.1

# Extra allowed CORS origins, comma-separated. localhost and
# https://littleanti.github.io are always allowed by default.
# WEB_ORIGIN=https://staging.example.com,https://preview.example.com
