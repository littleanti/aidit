# ── Database ──────────────────────────────────────────────────────────
# Prisma connection string. Local/dev uses a SQLite file under prisma/.
# In production set this to your real database URL (e.g. a Postgres URL).
DATABASE_URL="file:./dev.db"

# ── Server ────────────────────────────────────────────────────────────
# TCP port the API server listens on (default 3001).
PORT=3001

# Network bind address for the API server.
# Default: 0.0.0.0 (all interfaces). Set HOST=127.0.0.1 to keep the API
# reachable only from the local machine (e.g. behind a frontend dev proxy)
# and NOT exposed on the LAN.
# HOST=127.0.0.1

# ── LLM provider ──────────────────────────────────────────────────────
# LLM model id the BYOK client calls (calls happen browser-side; the server
# stays key-blind and only references the id). Defaults to the Gemini model
# the app ships with. Override to switch providers/models.
# LLM_MODEL=gemini-3.1-flash-lite

# ── Auth (JWT) ────────────────────────────────────────────────────────
# JWT secret used to sign and verify Bearer tokens.
# REQUIRED in production — generate with: openssl rand -hex 32
# If unset the server falls back to an insecure dev default and prints a warning.
# JWT_SECRET=change-me-in-production

# JWT token lifetime (default 7d). Accepts any value supported by the `ms` library
# (e.g. "7d", "24h", "3600").
# JWT_EXPIRES=7d

# ── Routing / CORS ────────────────────────────────────────────────────
# Base URL prefix for API routes. Keep "/" for local/dev or set "/api" for reverse-
# proxy deployments that mount the API path under /api (e.g. https://aidit.uitae.kim/api).
# If omitted or set to "/", routes remain at root.
# API_PREFIX=/

# Allowed CORS origins, comma-separated. Only localhost/127.0.0.1 and private-LAN
# IPv4 over http are allowed by default (for local + phone-on-Wi-Fi dev), so the
# PRODUCTION frontend origin MUST be listed here. There is no hardcoded production
# origin: the former https://littleanti.github.io default was removed on
# 2026-07-28 along with the rest of the GitHub Pages plan (deployment is
# self-hosted — see README "배포 · CI").
# WEB_ORIGIN=https://app.example.com,https://staging.example.com

# ── Scaling (multi-instance) ──────────────────────────────────────────
# When set, thread events fan out over Redis pub/sub AND rate-limit counters are
# shared, so several app instances behave as one (TRD §15.2-15.3). Unset =>
# in-memory: correct for a SINGLE instance only.
# REDIS_URL=redis://127.0.0.1:6379
#
# Running more than one instance needs all THREE of:
#   DATABASE_URL=postgresql://...   (not SQLite)
#   REDIS_URL=redis://...           (shared bus + shared limits)
#   STORAGE_BACKEND=s3              (uploads must not live on one instance's disk)
# With REDIS_URL set and STORAGE_BACKEND=local the server warns at startup.

# ── Storage (uploads) ─────────────────────────────────────────────────
# Storage backend for uploads. Use "local" (default) for dev with filesystem
# storage under <server>/uploads, or "s3" to store uploads in S3.
# STORAGE_BACKEND=local

# S3 configuration (required when STORAGE_BACKEND=s3).
# AWS_REGION=ap-northeast-2
# AWS_S3_BUCKET_NAME=aidit-uploads-prod
# S3_UPLOAD_PREFIX=uploads
# Optional. If omitted, the default public URL format is:
# https://{AWS_S3_BUCKET_NAME}.s3.{AWS_REGION}.amazonaws.com/{S3_UPLOAD_PREFIX}/<file>
# Set this to CloudFront domain or any custom public origin for production.
# S3_PUBLIC_BASE_URL=https://d1234567890abcdef.cloudfront.net
