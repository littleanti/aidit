{
  "name": "aidit-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "dev:once": "tsx src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:pg:sync": "node scripts/sync-postgres-schema.mjs",
    "db:pg:check": "node scripts/sync-postgres-schema.mjs --check",
    "db:pg:ddl": "npm run db:pg:sync && prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.postgres.prisma --script > prisma/postgres/init.sql",
    "db:pg:push": "npm run db:pg:sync && prisma db push --schema prisma/schema.postgres.prisma",
    "db:pg:generate": "npm run db:pg:sync && prisma generate --schema prisma/schema.postgres.prisma",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "load:sim": "tsx test/load/simulate.mjs",
    "calibrate:tokens": "tsx scripts/calibrate-token-estimate.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.1.3",
    "@prisma/client": "^6.2.1",
    "@aws-sdk/client-s3": "^3.799.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.17.12",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
