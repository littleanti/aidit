# Backend origin for production / GitHub Pages builds.
# Leave empty (or unset) for local dev — Vite proxies /api and /uploads to localhost:3001.
# Set to the deployed backend origin WITHOUT a trailing slash and WITHOUT /api suffix.
# Example: VITE_API_ORIGIN=https://aidit-api.onrender.com
VITE_API_ORIGIN=

# SPA base path. Default "/" is correct for a GitHub USER page (username.github.io).
# For a PROJECT page (username.github.io/repo-name) set to /repo-name/
# VITE_BASE=/

# ── LLM provider (BYOK) ───────────────────────────────────────────────
# The LLM provider is abstracted so it can be swapped without code changes.
# Both are OPTIONAL — if unset, the app defaults to Google Gemini.
#
# Model id the browser BYOK client calls.
# VITE_LLM_MODEL=gemini-3.1-flash-lite
#
# REST API base the browser fetches DIRECTLY (BYOK; user's own key per call).
# VITE_LLM_BASE=https://generativelanguage.googleapis.com/v1beta
